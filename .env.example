# Anthropic API key (required for the conversational agent)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Robinhood credentials
RH_USERNAME=your_email@example.com
RH_PASSWORD=your_password

# Optional: MFA secret (base32) if you use TOTP-based 2FA
# Leave blank to be prompted at runtime
RH_MFA_SECRET=

# Cache settings
CACHE_TTL_SECONDS=300
